{
  "name": "@local/polyglot-bridge",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Contract-first bridge between language frameworks, with a bundled Python LangGraph service.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "runtime",
    "vendor",
    "service",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
