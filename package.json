{
  "name": "@local/koine",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Koine: one contract, many languages. Extract a language-neutral HTTP contract, generate clients and server skeletons, and grade drift.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "runtime",
    "vendor",
    "service",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
